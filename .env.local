# Backend configuration
TYPO3_CONF_VARS__BE__lockSSL=1

# Backend require MFA
# TYPO3_CONF_VARS__BE_requireMfa=1

 

# ================================
# General Configuration
# ================================

TYPO3_CONF_VARS__BE__installToolPassword='$argon2i$v=19$m=65536,t=16,p=1$vg9aaiGXF2aU2dTHNgHUbg$8I+L247/bAYWL0mIG1RKZvQT1czQ1B89vpIoXVMFdNg'
TYPO3_CONF_VARS__BE__lockSSL=true
TYPO3_CONF_VARS__FE__cookieSameSite=strict

# ================================
# Database Credentials
# ================================

TYPO3_CONF_VARS__DB__Connections__Default__host="db"
TYPO3_CONF_VARS__DB__Connections__Default__port=3306
TYPO3_CONF_VARS__DB__Connections__Default__password="db"
TYPO3_CONF_VARS__DB__Connections__Default__user="db"
TYPO3_CONF_VARS__DB__Connections__Default__dbname="db"

# ================================
# System Configuration
# ================================

# {{ version }} is replaced during deployment ("package" stage)
TYPO3_CONF_VARS__SYS__sitename="SUET – local"
TYPO3_CONF_VARS__SYS__trustedHostsPattern="(.*)\.ddev\.site"

# file/folder permissions
TYPO3_CONF_VARS__SYS__fileCreateMask=660
TYPO3_CONF_VARS__SYS__folderCreateMask=770

# ================================
# Mail Configuration
# ================================

TYPO3_CONF_VARS__MAIL__transport=smtp
TYPO3_CONF_VARS__MAIL__transport_smtp_server=sslout.de:465
TYPO3_CONF_VARS__MAIL__transport_smtp_domain=suet.de
TYPO3_CONF_VARS__MAIL__transport_smtp_encrypt=true
TYPO3_CONF_VARS__MAIL__transport_smtp_password='u#bCW6-eW4Gw215-46'
TYPO3_CONF_VARS__MAIL__transport_smtp_username=noreplay@suet.de

TYPO3_CONF_VARS__MAIL__defaultMailFromAddress=noreplay@suet.de
TYPO3_CONF_VARS__MAIL__defaultMailFromName=noreplay@suet.de
TYPO3_CONF_VARS__MAIL__defaultMailReplyToAddress=noreplay@suet.de
TYPO3_CONF_VARS__MAIL__defaultMailReplyToName=noreplay@suet.de


# ================================
# Debug Configuration
# ================================

TYPO3_CONF_VARS__FE__debug=1
TYPO3_CONF_VARS__BE__debug=1
TYPO3_CONF_VARS__SYS__devIPmask=*
TYPO3_CONF_VARS__SYS__displayErrors=1
TYPO3_CONF_VARS__SYS__systemLogLevel=1
TYPO3_CONF_VARS__SYS__errorHandlerErrors=30466
TYPO3_CONF_VARS__SYS__exceptionalErrors=4096
TYPO3_CONF_VARS__SYS__belogErrorReporting=6133
TYPO3_CONF_VARS__SYS__systemLogLevel=0
#TYPO3_CONF_VARS__SYS__errorHandlerErrors=30466
#TYPO3_CONF_VARS__SYS__exceptionalErrors=12290
#TYPO3_CONF_VARS__SYS__belogErrorReporting=30711
# enable deprecations
# TYPO3_CONF_VARS__LOG__TYPO3__CMS__deprecations__writerConfiguration__notice__TYPO3_bs_CMS_bs_Core_bs_Log_bs_Writer_bs_FileWriter__disabled="bool(false)"
# disable deprecations
# TYPO3_CONF_VARS__LOG__TYPO3__CMS__deprecations__writerConfiguration__notice="array()"

# TYPO3s compression is unnecessary and error-prone
TYPO3_CONF_VARS__FE__compressionLevel=0
TYPO3_CONF_VARS__BE__compressionLevel=0

# Backend IP Login configuration, keep LocalConfiguration.php clean
TYPO3__EXTENSIONS__backend_ip_login__configuration__networkMask='255.255.255.0'
TYPO3__EXTENSIONS__backend_ip_login__configuration__useNetworkAddress='0'
TYPO3__EXTENSIONS__backend_ip_login__option__allowLocalNetwork='1',
TYPO3__EXTENSIONS__backend_ip_login__option__disableInProductionContext='1'
TYPO3__EXTENSIONS__backend_ip_login__option__displayAccounts='1'
TYPO3__EXTENSIONS__backend_ip_login__option__limitToDdevContext='0'