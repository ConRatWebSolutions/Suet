#### CTYPE: team_content ####
tt_content.team_content >
tt_content.team_content =< lib.contentElement
tt_content.team_content {
    templateName = TeamContent
    templateRootPaths {
        20 = EXT:c4theme/Resources/Private/Templates/ContentElements/
    }
    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = image
            as = previewImage
        }
    }
}
